import java.util.*;
public class Main{
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int rating[]=new int[5];
        int sum=0;
        for(int i=0;i<5;i++){
            System.out.print("Order "+(i+1)+": ");
            rating[i]=sc.nextInt();
            while(rating[i]<=0 || rating[i]>5){
                    System.out.println("Invalid rating! Rate between(1-5)");
                    System.out.print("Order "+(i+1)+": ");
                    rating[i]=sc.nextInt();
            }
            sum+=rating[i];
        }
        System.out.println((float)sum/5);
        System.out.println((float)sum/5>3.8?"Offer available!!":"No Offer Available! Better luck next time.");
    }
}
