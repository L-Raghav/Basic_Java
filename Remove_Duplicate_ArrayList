import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner sc = new Scanner(System.in);
		ArrayList <Integer> a = new ArrayList<>();
		System.out.println("Enter size: ");
		int n = sc.nextInt();
		for(int i=0; i<n; i++){
		    a.add(sc.nextInt());
		}
		for(int i=0; i<a.size(); i++){
		    for(int j=i+1; j<(a.size()-1); j++){
		        if(a.get(i) == a.get(j))
		            a.remove(j);
		    }
		}
		System.out.print(a);
	}
};
